{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": ["tsc", "-b", "--noEmit"],
            "timeout": 120,
            "statusMessage": "Verificando tipos..."
          }
        ]
      }
    ]
  }
}
